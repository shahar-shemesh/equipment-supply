{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run migration:show)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d)",
      "Bash(npm audit*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git fetch origin --quiet)",
      "Bash(git merge-base *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/handoff.md\"; if [ -f \"$f\" ]; then printf '## Handoff from the previous session (.claude/handoff.md)\\n\\n'; cat \"$f\"; fi 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Loading handoff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-push-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking pre-push marker"
          }
        ]
      }
    ]
  }
}
