# copy to .env - the values below match docker-compose.yml at the repo root

# LOCAL turns on the developer switches below (dev accounts on the login page, default jwt secret, seed, schema sync).
# anything else, or NODE_ENV=production, turns them all off. see src/env.ts
ENVIRONMENT=LOCAL
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=equipment
DB_PASSWORD=equipment
DB_NAME=equipment_supply
# DB_LOGGING=1

# typeorm synchronize: rebuild tables from the entity classes on start. LOCAL only.
# outside LOCAL the schema moves with migrations: npm run migration:run (ts-node, from the sources) or
# npm run migration:run:prod (from dist, no devDependencies needed) before starting the new build. see src/migrations
DB_SYNCHRONIZE=true
# npm run seed truncates every table. LOCAL only
ALLOW_DESTRUCTIVE_SEED=true
# generated issuances on top of the 30 handcrafted ones, 0 for the handcrafted set only. unset = 2000
# SEED_BULK=2000

# dev-local = seeded username/password accounts (see src/seed/seed.data.ts).
# nothing else is implemented yet, the production identity provider is still an open decision.
# outside LOCAL the server refuses to start with dev-local unless ALLOW_DEV_AUTH=true (a test box with no real provider yet)
AUTH_STRATEGY=dev-local
# ALLOW_DEV_AUTH=true

# outside LOCAL this must be set to a real secret, the server refuses to start otherwise
JWT_SECRET=dev-only-secret-change-me

# xml export of every issuance status change to s3 (docs/xml-export.md). the outbox rows are written whatever this says;
# true starts the worker that uploads them, and then AWS_REGION and XML_EXPORT_BUCKET are required (the server refuses to
# start without them). credentials come from the sdk's default chain (a role, a profile, AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in the environment), never from a variable of this file
XML_EXPORT_ENABLED=false
# where the documents land: s3 (unset) or local, a directory on this machine for development and testing, with the
# same keys as the bucket and no need for a region, a bucket or credentials. anything else refuses to start
# XML_EXPORT_STORAGE=s3
# the directory of the local backend, relative to the server's working directory (server/exports is git ignored)
# XML_EXPORT_LOCAL_DIR=./exports/xml
# AWS_REGION=il-central-1
# XML_EXPORT_BUCKET=issuance-exports
# the folder inside the bucket, letters digits . _ - / only, ending with /, empty for the bucket root
# XML_EXPORT_PREFIX=issuance-status-changes/
# XML_EXPORT_POLL_MS=5000
# XML_EXPORT_BATCH=20
# XML_EXPORT_LEASE_MS=60000
# XML_EXPORT_MAX_ATTEMPTS=20
# an s3 compatible endpoint with path style addressing (MinIO, LocalStack) on a laptop; unset means aws
# XML_EXPORT_S3_ENDPOINT=http://localhost:9000
# encrypt the objects with this kms key (aws:kms); unset means AES256
# XML_EXPORT_KMS_KEY_ID=
