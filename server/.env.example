# copy to .env - the values below match docker-compose.yml at the repo root

# LOCAL turns on the developer switches below (dev accounts on the login page, default jwt secret, seed, schema sync).
# anything else, or NODE_ENV=production, turns them all off. see src/env.ts
ENVIRONMENT=LOCAL
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=equipment
DB_PASSWORD=equipment
DB_NAME=equipment_supply
# DB_LOGGING=1

# typeorm synchronize: rebuild tables from the entity classes on start. LOCAL only, migrations are the next step
DB_SYNCHRONIZE=true
# npm run seed truncates every table. LOCAL only
ALLOW_DESTRUCTIVE_SEED=true

# dev-local = seeded username/password accounts (see src/seed/seed.data.ts).
# nothing else is implemented yet, the production identity provider is still an open decision.
# outside LOCAL the server refuses to start with dev-local unless ALLOW_DEV_AUTH=true (a test box with no real provider yet)
AUTH_STRATEGY=dev-local
# ALLOW_DEV_AUTH=true

# outside LOCAL this must be set to a real secret, the server refuses to start otherwise
JWT_SECRET=dev-only-secret-change-me
