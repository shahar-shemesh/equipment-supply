# copy to .env - the database values match docker-compose.yml at the repo root (the same database as the server)

# LOCAL is a developer's machine: /status and /run may run without ETL_ADMIN_TOKEN (warned loudly). anything else, or
# NODE_ENV=production, requires the token. see src/config/env.ts
ENVIRONMENT=LOCAL
# the http port of /health, /status and /run
PORT=3101

DB_HOST=localhost
DB_PORT=5433
DB_USER=equipment
DB_PASSWORD=equipment
DB_NAME=equipment_supply
# the database the e2e specs create and wipe. never equipment_supply or equipment_supply_test
# DB_NAME_TEST=equipment_supply_etl_test

# the three directories, relative paths resolve against this package's root (never the working directory), created at
# startup. SAP drops documents into input; an imported file moves to archive, a refused one to error with a
# <name>.error.json next to it; a file that failed on a transient error stays in input for the next run
# XML_INPUT_DIR=./data/input
# XML_ARCHIVE_DIR=./data/archive
# XML_ERROR_DIR=./data/error

# true (unset) polls the input directory every ETL_POLL_INTERVAL_MS; false runs only on POST /run
ETL_AUTO_START=true
# ETL_POLL_INTERVAL_MS=10000
# files per run, sorted by name, the rest wait for the next run
# ETL_BATCH_SIZE=100
# a file modified less than this many ms ago is still being written and waits for the next run
# ETL_MIN_FILE_AGE_MS=2000
# a larger file is refused without being read (5 MiB)
# ETL_MAX_FILE_BYTES=5242880
# how long a claim on a file belongs to this process; another instance may take it over after that
# ETL_LEASE_MS=300000
# a file that failed on a transient error this many times is refused for good
# ETL_MAX_ATTEMPTS=10

# the bearer token of GET /status and POST /run. required outside LOCAL, the service refuses to start without it
# ETL_ADMIN_TOKEN=change-me
# the name this process claims files under (xml_import_files.instance_id); unset is <hostname>-<pid>
# ETL_INSTANCE_ID=
# debug | info | warn | error
# ETL_LOG_LEVEL=info
