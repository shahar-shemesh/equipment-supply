{
  "name": "equipment-supply-issuance-xml-import",
  "version": "0.0.1",
  "description": "polls a directory for SAP issuance xml documents and upserts them into the equipment-supply database",
  "private": true,
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/etls/issuance-xml-import/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/e2e/**\"",
    "test:e2e": "vitest run src/e2e"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typeorm": "^0.3.31",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
